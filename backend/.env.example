# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=inventory

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# AI assistant (Google Gemini). Leave GEMINI_API_KEY empty to disable the assistant.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
